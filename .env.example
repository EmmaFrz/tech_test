# Simulator settings for Docker Compose. Copy this file to `.env` next to `docker-compose.yml` and
# change what you need; every value below is the default. Outside Docker, set the variables in your
# shell instead. Invalid values stop the simulator at startup with a descriptive error.

# Number of simulated nodes (1 to 100000).
NODE_COUNT=200

# Milliseconds between update batches (10 to 60000).
TICK_MS=100

# Fraction of nodes that report in each batch (0.001 to 1).
UPDATE_RATIO=0.3

# Seed of the generator; the same seed replays the same stream (0 to 4294967295).
SEED=42

# Nodes kept in the critical state (0 to NODE_COUNT). Leave it empty for the default: 3, or every
# node of a smaller fleet.
FORCE_CRITICAL=

# Chance per batch that one node goes silent for 12 to 24 seconds (0 to 1).
DROPOUT_RATIO=0.01

# Log level: debug, info, warn or error.
LOG_LEVEL=info
